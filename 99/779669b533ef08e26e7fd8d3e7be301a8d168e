<?php

function splitOutsideParenthesis(string $type): array
{
    $parts = [];
    $currentPart = '';
    $parenthesisLevel = 0;

    $typeLength = \strlen($type);
    for ($i = 0; $i < $typeLength; ++$i) {
        $char = $type[$i];

        if ('(' === $char) {
            ++$parenthesisLevel;
        } elseif (')' === $char) {
            --$parenthesisLevel;
        }

        if ('|' === $char && 0 === $parenthesisLevel) {
            $parts[] = $currentPart;
            $currentPart = '';
        } else {
            $currentPart .= $char;
        }
    }

    if ('' !== $currentPart) {
        $parts[] = $currentPart;
    }

    return $parts;
}

