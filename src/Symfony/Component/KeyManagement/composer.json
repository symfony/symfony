{
    "name": "symfony/key-management",
    "type": "library",
    "description": "Abstracts Key Management Systems (AWS KMS, Azure Key Vault, Google Cloud KMS, HashiCorp Vault Transit, ...) behind a single interface",
    "keywords": ["kms", "encryption", "key management", "secrets", "vault"],
    "homepage": "https://symfony.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Jérôme Tamarelle",
            "email": "jerome@tamarelle.net"
        },
        {
            "name": "Florent Morselli",
            "email": "florent.morselli@spomky-labs.com"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "symfony/polyfill-mbstring": "^1.0"
    },
    "require-dev": {
        "psr/container": "^1.1|^2.0",
        "symfony/console": "^7.4|^8.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/filesystem": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0",
        "symfony/process": "^7.4|^8.0",
        "symfony/serializer": "^7.4|^8.0",
        "symfony/service-contracts": "^2.5|^3.0",
        "symfony/uid": "^7.4|^8.0",
        "symfony/var-dumper": "^7.4|^8.0"
    },
    "conflict": {
        "symfony/config": "<8.2",
        "symfony/console": "<7.4",
        "symfony/dependency-injection": "<8.2",
        "symfony/serializer": "<7.4",
        "symfony/service-contracts": "<2.5",
        "symfony/web-profiler-bundle": "<8.2"
    },
    "autoload": {
        "psr-4": { "Symfony\\Component\\KeyManagement\\": "" },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "minimum-stability": "dev"
}
