{
    "name": "symfony/json-schema",
    "type": "library",
    "description": "Generates JSON Schema documents from PHP types.",
    "keywords": ["json", "schema", "json-schema", "openapi"],
    "homepage": "https://symfony.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Fabien Potencier",
            "email": "fabien@symfony.com"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/polyfill-php84": "^1.30",
        "symfony/property-info": "^7.4|^8.0",
        "symfony/type-info": "^7.4.6|^8.0.6"
    },
    "require-dev": {
        "phpdocumentor/reflection-docblock": "^5.2|^6.0",
        "phpstan/phpdoc-parser": "^1.30|^2.0",
        "symfony/config": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.2",
        "symfony/filesystem": "^7.4|^8.0",
        "symfony/property-access": "^7.4|^8.0",
        "symfony/serializer": "^7.4|^8.0",
        "symfony/translation-contracts": "^2.5|^3",
        "symfony/uid": "^7.4|^8.0",
        "symfony/validator": "^7.4|^8.0"
    },
    "conflict": {
        "phpdocumentor/reflection-docblock": "<5.2|>=7",
        "phpdocumentor/type-resolver": "<1.5.1",
        "symfony/serializer": "<7.4",
        "symfony/validator": "<7.4"
    },
    "autoload": {
        "psr-4": { "Symfony\\Component\\JsonSchema\\": "" },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "minimum-stability": "dev"
}
