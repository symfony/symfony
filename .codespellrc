[codespell]
# "smove" is the name of a Redis command
# "hastable" is Doctrine's Schema::hasTable() method
# "signall" is the $signAll property of Messenger's SigningSerializer
# "caf" comes from the "café" test fixtures of the HttpClient recorder
# "ser" is the $ser variable of Config's ResourceCheckerConfigCache
# "atleast" is PHPUnit's TestCase::atLeast()
# "grigorian" is the name of an author of Console's Table helper
# "truncat" is the expected output of FormatterHelper::truncate() in Console's FormatterHelperTest
# "nam", "ment", "secon", "afte", "thre", "whe", "nce", "siz" and "thi" are wrapped or clipped words in terminal snapshots
ignore-words-list = smove,hastable,signall,caf,ser,atleast,grigorian,truncat,nam,ment,secon,afte,thre,whe,nce,siz,thi

# Generated hyphenation patterns and their source notices are not English prose.
ignore-multiline-regex = \A<\?php\n\n/\*\n \* Generated by Resources/bin/update-hyphenation\.php from hyph-utf8, do not edit\.\n.*

# Encoded image bytes in data URIs are not words.
ignore-regex = \bdata:[^;\s]+;base64,[A-Za-z0-9+/=]+
