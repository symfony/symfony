<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd
                               http://symfony.com/schema/dic/security http://symfony.com/schema/dic/security/security-1.0.xsd">

    <config xmlns="http://symfony.com/schema/dic/security">
        <firewall name="with_string">
            <access-token default-roles="ROLE_FOO">
                <token-handler>
                    <oidc audience="audience" keyset='{"keys":[{"kty":"RSA","n":"abc","e":"AQAB"}]}'>
                        <issuer>https://www.example.com</issuer>
                        <algorithm>RS256</algorithm>
                    </oidc>
                </token-handler>
            </access-token>
        </firewall>

        <firewall name="with_array">
            <access-token default-roles="ROLE_FOO, ROLE_BAR">
                <token-handler>
                    <oidc audience="audience" keyset='{"keys":[{"kty":"RSA","n":"abc","e":"AQAB"}]}'>
                        <issuer>https://www.example.com</issuer>
                        <algorithm>RS256</algorithm>
                    </oidc>
                </token-handler>
            </access-token>
        </firewall>
    </config>
</container>
