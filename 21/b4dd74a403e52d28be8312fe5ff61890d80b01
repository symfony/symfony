```php
class Mapper
{
    public static function mapObjectToObject($source, $dist, $mapping)
    {
        $propertyAccessor = PropertyAccess::createPropertyAccessor();
        foreach ($mapping as $attributeName => $value) {
            // if the value is null, take the value within the object. Easier to write the mapping array this way.

            if ($value instanceof PropertyPath) {
                $value = $propertyAccessor->getValue($source, $value->getPath());
            } elseif (null === $value && is_array($source) && (isset($source[$attributeName]))) {
                $value = $source[$attributeName];
            } elseif (is_callable($value)) {
                $value = $value();
            } elseif (null === $value and ($propertyAccessor->isReadable($source, $attributeName))) {
                $value = $propertyAccessor->getValue($source, $attributeName);
            } elseif (is_callable($value) and $propertyAccessor->isReadable($source, $attributeName)) {
                $value = $value($propertyAccessor->getValue($source, $attributeName));
            } elseif (is_callable($value) and !$propertyAccessor->isReadable($source, $attributeName)) {
                $value = $value();
            }
            $propertyAccessor->setValue($dist, $attributeName, $value);
        }
    }

    public static function mapObjectToArray($source, $dist, $mapping)
    {
        $propertyAccessor = PropertyAccess::createPropertyAccessor();
        foreach ($mapping as $attributeName => $value) {
            switch (true) {
                case $value instanceof PropertyPath:
                    if ($value->failSilently()) {
                        try {
                            $path  = $value->getPath() ?: $attributeName;
                            $value = $propertyAccessor->getValue($source, $path);
                        } catch (Exception $e) {
                            $value = $value->failValue();
                        }
                    } else {
                        $path  = $value->getPath() ?: $attributeName;
                        $value = $propertyAccessor->getValue($source, $path);
                    }

                    break;
                case $value === null:
                    $value = $propertyAccessor->getValue($source, $attributeName);
                    break;
                case $value instanceof Value:
                    $value = $value->getValue();
                    break;
                case is_callable($value):
                    $value = $value();
                    break;
            }
            $dist[$attributeName] = $value;
        }
        return $dist;
    }

