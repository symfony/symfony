```bash
for i in $(seq 0 10 100) ; do echo -n -e "\033]9;4;1;${i}\033\\" ; echo -n "${i} " ; sleep 0.5 ; done ; echo -n -e "\033]9;4;0;${i}\033\\" ; echo
