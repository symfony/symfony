{
    "name": "symfony/tui-html-bridge",
    "type": "library",
    "description": "Integrates the HtmlRenderer component with Symfony Tui",
    "keywords": [
        "tui",
        "terminal",
        "console",
        "cli"
    ],
    "homepage": "https://symfony.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Fabien Potencier",
            "email": "fabien@symfony.com"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "ext-dom": "*",
        "symfony/tui": "^8.3",
        "psr/log": "^1|^2|^3",
        "symfony/html-renderer": "^8.3",
        "symfony/string": "^7.4|^8.0"
    },
    "require-dev": {
        "league/commonmark": "^2.9",
        "org_heigl/hyphenator": "^3.2",
        "symfony/asset-mapper": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/property-access": "^7.4|^8.0",
        "symfony/ux-twig-component": "^3.5",
        "tempest/highlight": "^2.16",
        "twig/twig": "^3.12|^4.0"
    },
    "conflict": {
        "org_heigl/hyphenator": "<3.2",
        "symfony/asset-mapper": "<7.4",
        "symfony/ux-twig-component": "<3.5",
        "twig/twig": "<3.12"
    },
    "suggest": {
        "ext-gd": "To draw images, like HTML <img>",
        "ext-intl": "To draw bidirectional text, like Arabic and Hebrew, in visual order",
        "league/commonmark": "To render <tui-markdown> elements, with tempest/highlight",
        "org_heigl/hyphenator": "To hyphenate words with CSS hyphens: auto, through HeiglHyphenator",
        "symfony/asset-mapper": "To load CSS stylesheets and images from mapped assets",
        "symfony/ux-twig-component": "To build HTML views from Twig components",
        "tempest/highlight": "To render <tui-markdown> elements, with league/commonmark",
        "twig/twig": "To build HTML views from Twig templates"
    },
    "autoload": {
        "psr-4": {
            "Symfony\\Bridge\\TuiHtml\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "minimum-stability": "dev"
}
