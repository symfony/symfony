/* Panel-scoped tweaks to embed the ErrorHandler exception fragment inside the profiler.
   The base styles come from ErrorHandler's exception.css (injected just before this file,
   scoped to .sf-reset); profiler.css loads after both, so these overrides rely on
   .sf-reset / #collector-wrapper specificity to win the cascade. */

/* the profiler stores its theme as a class on <body> and the injected stylesheet keys its
   light-dark() tokens off color-scheme; map one to the other so the fragment follows the
   profiler theme instead of the OS preference (the extra .sf-reset specificity beats the
   scoped ":scope { color-scheme: light dark }" declared on the same element) */
body.theme-light .sf-reset { color-scheme: light; }
body.theme-dark .sf-reset { color-scheme: dark; }

.sf-reset .container { max-width: none; margin: 0; padding: 0; }

#collector-wrapper .sf-reset h2 { font-size: 15px; font-weight: 600; margin: 30px 0 15px; padding: 0; box-shadow: none; }
#collector-wrapper .sf-reset .trace-header h2 { margin: 0 0 2px; }

.sf-reset .exceptions-header {
    background: var(--card);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-xs);
    margin-bottom: 15px;
    --header: var(--card);
    --header-foreground: var(--destructive);
    --header-foreground-muted: var(--muted-foreground);
}
.sf-reset .exc-subtitle { color: var(--muted-foreground); }
.sf-reset .exc-status { background: var(--muted); }

.sf-reset .exception-chain { --chain-line-color: var(--border); --chain-hover-bg: var(--accent); }
.sf-reset .exception-chain li { margin: 0; }
.sf-reset .exception-chain > li:not(:last-child)::before { background: var(--border); height: 1px; }
.sf-reset .exc-item-marker { border-color: var(--border); }
.sf-reset .exc-item-message { color: var(--muted-foreground); }

.sf-reset .tab-navigation {
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
    display: inline-grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
}
.sf-reset .sf-tabs-sm .tab-navigation { box-shadow: inset 0 0 0 1px var(--border); }
.sf-reset .trace-format-tabs .tab-navigation { margin: 0; }
.sf-reset .tab-navigation .tab-control::before { content: none; }
.sf-reset .tab-navigation .tab-control[aria-selected="true"] { color: var(--card-foreground); }
