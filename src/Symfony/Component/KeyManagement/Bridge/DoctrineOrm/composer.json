{
    "name": "symfony/doctrine-orm-key-management",
    "type": "symfony-key-management-bridge",
    "description": "Symfony Doctrine ORM Key Management Bridge",
    "keywords": ["kms", "doctrine", "orm", "encryption"],
    "homepage": "https://symfony.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Florent Morselli",
            "email": "florent.morselli@spomky-labs.com"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "doctrine/orm": "^3.4",
        "psr/container": "^1.1|^2.0",
        "symfony/doctrine-bridge": "^7.4.10|^8.0.10",
        "symfony/doctrine-dbal-key-management": "^8.2",
        "symfony/key-management": "^8.2"
    },
    "require-dev": {
        "symfony/cache": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0"
    },
    "suggest": {
        "symfony/dependency-injection": "Required to use the RegisterBlindIndexesPass, which hands the listener the blind indexes the application registered"
    },
    "autoload": {
        "psr-4": { "Symfony\\Component\\KeyManagement\\Bridge\\DoctrineOrm\\": "" },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "minimum-stability": "dev"
}
