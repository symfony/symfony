use Symfony\Component\AutoMapper\AutoMapper;
use Symfony\Component\AutoMapper\Attributes\MapIf;
use Symfony\Component\AutoMapper\Attributes\MapTo;
use Symfony\Component\AutoMapper\Attributes\MapWith;

// This maps class `A` to class `B`.
#[MapTo(B::class)]
class A
{
    // This maps A::foo to B::bar.
    #[MapTo('bar')]
    public string $foo;

    // This calls strtoupper on A::transform
    #[MapWith('ucfirst')]
    public string $name;

    // This doesn't map A::bar if it's value is falsy.
